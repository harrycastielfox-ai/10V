// Logo compactada e incorporada no próprio arquivo para o painel não depender
// de links externos ou de arquivos do computador.
const PAINEL_BO_LOGO_BASE64 = "";

/**
 * Monta ou recria toda a aba PAINEL.
 * Se a aba já tiver conteúdo, pede confirmação antes de limpar.
 */
function criarPainelBo() {
  const planilha = abrirPlanilhaPainelBo_();
  const base = exigirBasePainelBo_(planilha);
  let painel = planilha.getSheetByName(PAINEL_BO.PANEL_SHEET);

  if (!painel) {
    painel = planilha.insertSheet(PAINEL_BO.PANEL_SHEET);
  } else if (painelPossuiConteudo_(painel)) {
    const resposta = SpreadsheetApp.getUi().alert(
      "Recriar o painel?",
      "A aba PAINEL já possui conteúdo. Somente essa aba será limpa e reconstruída; os B.O.s não serão alterados.",
      SpreadsheetApp.getUi().ButtonSet.YES_NO
    );
    if (resposta !== SpreadsheetApp.getUi().Button.YES) {
      planilha.toast("Operação cancelada. Nada foi alterado.", "Painel de B.O.", 5);
      return;
    }
  }

  const bloqueio = LockService.getDocumentLock();
  bloqueio.waitLock(30000);

  try {
    prepararEstruturaPainelBo_(painel);
    montarLayoutPainelBo_(painel);
    const dados = obterDadosPainelBo_(base);
    atualizarConteudoPainelBo_(planilha, painel, dados);
    instalarAtualizacaoAutomaticaPainelBo();
    planilha.setActiveSheet(painel);
    planilha.setActiveSelection("A1");
    SpreadsheetApp.flush();
    planilha.toast("Painel criado com sucesso.", "Painel de B.O.", 6);
  } finally {
    bloqueio.releaseLock();
  }
}

/**
 * Recalcula os indicadores, as listas e os gráficos sem remontar o visual.
 */
function atualizarPainelBo() {
  const planilha = abrirPlanilhaPainelBo_();
  const base = exigirBasePainelBo_(planilha);
  const painel = planilha.getSheetByName(PAINEL_BO.PANEL_SHEET);

  if (!painel || painel.getRange("A1").getNote() !== "PAINEL_BO_LAYOUT_V5") {
    throw new Error("O painel ainda não foi montado. Execute primeiro a função criarPainelBo().");
  }

  const bloqueio = LockService.getDocumentLock();
  bloqueio.waitLock(30000);

  try {
    const dados = obterDadosPainelBo_(base);
    atualizarConteudoPainelBo_(planilha, painel, dados);
    SpreadsheetApp.flush();
    planilha.toast("Painel atualizado com sucesso.", "Painel de B.O.", 5);
  } finally {
    bloqueio.releaseLock();
  }
}

/**
 * Instala uma única atualização automática ao abrir/recarregar a planilha.
 * É independente do onOpen usado pelos menus de cadastro e pesquisa.
 */
function instalarAtualizacaoAutomaticaPainelBo() {
  const nomeFuncao = "atualizarPainelAoAbrirBo_";
  const jaInstalado = ScriptApp.getProjectTriggers().some(function (gatilho) {
    return gatilho.getHandlerFunction() === nomeFuncao;
  });
  if (!jaInstalado) {
    ScriptApp.newTrigger(nomeFuncao)
      .forSpreadsheet(PAINEL_BO.SPREADSHEET_ID)
      .onOpen()
      .create();
  }
}

function atualizarPainelAoAbrirBo_() {
  try {
    const planilha = abrirPlanilhaPainelBo_();
    const base = exigirBasePainelBo_(planilha);
    const painel = planilha.getSheetByName(PAINEL_BO.PANEL_SHEET);
    if (!painel || painel.getRange("A1").getNote() !== "PAINEL_BO_LAYOUT_V5") return;

    const bloqueio = LockService.getDocumentLock();
    bloqueio.waitLock(30000);
    try {
      atualizarConteudoPainelBo_(planilha, painel, obterDadosPainelBo_(base));
      SpreadsheetApp.flush();
    } finally {
      bloqueio.releaseLock();
    }
  } catch (erro) {
    console.error("Falha ao atualizar o painel na abertura: " + erro.message);
  }
}

function abrirPlanilhaPainelBo_() {
  const planilha = SpreadsheetApp.openById(PAINEL_BO.SPREADSHEET_ID);
  if (planilha.getId() !== PAINEL_BO.SPREADSHEET_ID) {
    throw new Error("A planilha aberta não corresponde à planilha oficial de B.O.");
  }
  return planilha;
}

function exigirBasePainelBo_(planilha) {
  const base = planilha.getSheetByName(PAINEL_BO.BASE_SHEET);
  if (!base) {
    throw new Error('A aba "' + PAINEL_BO.BASE_SHEET + '" não foi encontrada.');
  }

  const encontrados = base.getRange(1, 1, 1, PAINEL_BO.HEADERS.length).getDisplayValues()[0];
  PAINEL_BO.HEADERS.forEach(function (esperado, indice) {
    if (normalizarPainelBo_(encontrados[indice]) !== normalizarPainelBo_(esperado)) {
      throw new Error(
        "A coluna " + (indice + 1) + ' deveria ser “' + esperado + '”, mas contém “' + encontrados[indice] + '”.'
      );
    }
  });
  return base;
}

function painelPossuiConteudo_(painel) {
  const possuiValor = painel
    .getDataRange()
    .getDisplayValues()
    .some(function (linha) {
      return linha.some(function (valor) {
        return String(valor).trim() !== "";
      });
    });
  return possuiValor || painel.getCharts().length > 0 || painel.getImages().length > 0;
}

function prepararEstruturaPainelBo_(painel) {
  if (painel.getMaxRows() < 34) {
    painel.insertRowsAfter(painel.getMaxRows(), 34 - painel.getMaxRows());
  }
  if (painel.getMaxColumns() < 18) {
    painel.insertColumnsAfter(painel.getMaxColumns(), 18 - painel.getMaxColumns());
  }

  painel.getCharts().forEach(function (grafico) {
    painel.removeChart(grafico);
  });
  painel.getImages().forEach(function (imagem) {
    imagem.remove();
  });
  painel.getBandings().forEach(function (faixa) {
    faixa.remove();
  });

  painel.getRange(1, 1, painel.getMaxRows(), painel.getMaxColumns()).breakApart();
  painel.clear();
  painel.setConditionalFormatRules([]);
  painel.setHiddenGridlines(true);
  painel.setFrozenRows(4);

  painel.showRows(1, Math.min(34, painel.getMaxRows()));
  painel.showColumns(1, Math.min(18, painel.getMaxColumns()));
  if (painel.getMaxRows() > 34) {
    painel.hideRows(35, painel.getMaxRows() - 34);
  }
  if (painel.getMaxColumns() > 18) {
    painel.hideColumns(19, painel.getMaxColumns() - 18);
  }

  painel.setColumnWidths(1, 18, 92);
  painel.setColumnWidth(1, 105);
  painel.setColumnWidth(2, 105);
  painel.setColumnWidth(9, 24);
  painel.setColumnWidth(10, 105);
  painel.setColumnWidth(18, 80);

  painel.setRowHeights(1, 4, 27);
  painel.setRowHeight(5, 12);
  painel.setRowHeight(6, 26);
  painel.setRowHeights(7, 3, 27);
  painel.setRowHeight(10, 10);
  painel.setRowHeights(11, 13, 19);
  painel.setRowHeights(21, 3, 6);
  painel.setRowHeight(24, 8);
  painel.setRowHeight(25, 27);
  painel.setRowHeight(26, 25);
  painel.setRowHeights(27, 4, 48);
  painel.setRowHeight(31, 24);
  painel.setRowHeight(32, 10);
  painel.setRowHeight(33, 25);

  painel
    .getRange(1, 1, 34, 18)
    .setFontFamily("Arial")
    .setFontColor(PAINEL_BO.COLORS.text)
    .setVerticalAlignment("middle");
  painel.getRange(1, 1, 34, 18).setBackground(PAINEL_BO.COLORS.light);
}

