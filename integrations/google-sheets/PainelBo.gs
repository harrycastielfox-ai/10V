function aplicarBordaPainelBo_(faixa, cor) {
  faixa.setBorder(true, true, true, true, false, false, cor, SpreadsheetApp.BorderStyle.SOLID);
}

function obterDadosPainelBo_(base) {
  const ultimaLinha = base.getLastRow();
  const valores = ultimaLinha > 1
    ? base.getRange(2, 1, ultimaLinha - 1, PAINEL_BO.HEADERS.length).getDisplayValues()
    : [];

  const registros = valores
    .map(function (linha, indice) {
      return {
        linha: indice + 2,
        numero: String(linha[0]).trim(),
        infracao: String(linha[1]).trim(),
        diligencias: String(linha[2]).trim(),
        responsavel: String(linha[3]).trim() || "Sem responsável",
        observacao: String(linha[4]).trim(),
        status: canonizarStatusPainelBo_(linha[5]),
      };
    })
    .filter(function (registro) {
      return registro.numero !== "";
    });

  const porStatus = {};
  PAINEL_BO.STATUSES.forEach(function (status) {
    porStatus[status] = 0;
  });
  const porResponsavel = {};
  const porInfracao = {};
  const porNatureza = {};
  PAINEL_BO_NATUREZAS.forEach(function (categoria) {
    porNatureza[categoria.nome] = 0;
  });
  porNatureza["OUTRAS OCORRÊNCIAS"] = 0;

  registros.forEach(function (registro) {
    if (!Object.prototype.hasOwnProperty.call(porStatus, registro.status)) {
      porStatus[registro.status] = 0;
    }
    porStatus[registro.status] += 1;
    porResponsavel[registro.responsavel] = (porResponsavel[registro.responsavel] || 0) + 1;

    extrairInfracoesPainelBo_(registro.infracao).forEach(function (infracao) {
      const rotulo = limparRotuloInfracaoPainelBo_(infracao);
      if (rotulo) {
        porInfracao[rotulo] = (porInfracao[rotulo] || 0) + 1;
      }
    });

    const textoInfracao = normalizarPainelBo_(registro.infracao);
    let encontrouCategoria = false;
    PAINEL_BO_NATUREZAS.forEach(function (categoria) {
      const corresponde = categoria.termos.some(function (termo) {
        return textoInfracao.indexOf(termo) !== -1;
      });
      if (corresponde) {
        porNatureza[categoria.nome] += 1;
        encontrouCategoria = true;
      }
    });
    if (!encontrouCategoria) {
      porNatureza["OUTRAS OCORRÊNCIAS"] += 1;
    }
  });

  const prioridades = registros
    .filter(function (registro) {
      return registro.status !== "Concluída" && registro.status !== "Cancelada";
    })
    .sort(function (a, b) {
      const diferenca = pesoStatusPainelBo_(a.status) - pesoStatusPainelBo_(b.status);
      return diferenca !== 0 ? diferenca : b.linha - a.linha;
    })
    .slice(0, 5);

  return {
    total: registros.length,
    porStatus: porStatus,
    porResponsavel: ordenarContagensPainelBo_(porResponsavel),
    porInfracao: ordenarContagensPainelBo_(porInfracao),
    porNatureza: porNatureza,
    prioridades: prioridades,
  };
}

function atualizarConteudoPainelBo_(planilha, painel, dados) {
  const concluidos = dados.porStatus["Concluída"] || 0;
  const taxaConclusao = dados.total ? concluidos / dados.total : 0;

  painel.getRange("A7").setValue(dados.total).setNumberFormat("0");
  painel.getRange("D7").setValue(dados.porStatus.Pendente || 0).setNumberFormat("0");
  painel.getRange("G7").setValue(dados.porStatus["Em Andamento"] || 0).setNumberFormat("0");
  painel.getRange("J7").setValue(dados.porStatus["Aguardando Terceiros"] || 0).setNumberFormat("0");
  painel.getRange("M7").setValue(concluidos).setNumberFormat("0");
  painel.getRange("P7").setValue(taxaConclusao).setNumberFormat("0%");

  painel.getRange("N1").clearContent();

  atualizarNaturezasPainelBo_(painel, dados.porNatureza);
  atualizarGraficosPainelBo_(planilha, painel, dados);
}

function atualizarNaturezasPainelBo_(painel, porNatureza) {
  const categorias = PAINEL_BO_NATUREZAS.map(function (categoria) {
    return categoria.nome;
  }).concat(["OUTRAS OCORRÊNCIAS"]);
  const celulasTitulo = ["A26", "D26", "G26", "J26", "M26", "P26", "A28", "D28", "G28", "J28", "M28", "P28"];
  const celulasValor = ["A27", "D27", "G27", "J27", "M27", "P27", "A29", "D29", "G29", "J29", "M29", "P29"];
  const cores = ["#C77D00", "#C0392B", "#64748B", "#168AAD", "#7251B5", "#9B2226", "#14805E", "#1F5FA8", "#B45309", "#7C3AED", "#BE185D", "#475569"];

  categorias.forEach(function (categoria, indice) {
    painel.getRange(celulasTitulo[indice]).setValue(categoria);
    painel
      .getRange(celulasValor[indice])
      .setValue(porNatureza[categoria] || 0)
      .setFontColor(cores[indice])
      .setNumberFormat("0");
  });
}

function atualizarPrioridadesPainelBo_(painel, prioridades) {
  painel.getRange("A27:I31").clearContent().setBackground(PAINEL_BO.COLORS.white);
  painel.getRange("A27:I31").setFontColor(PAINEL_BO.COLORS.text).setFontWeight("normal");

  if (!prioridades.length) {
    painel
      .getRange("A27")
      .setValue("Nenhum B.O. prioritário no momento.")
      .setFontColor(PAINEL_BO.COLORS.green)
      .setFontWeight("bold");
    return;
  }

  prioridades.forEach(function (registro, indice) {
    const linha = 27 + indice;
    painel.getRange(linha, 1).setValue(registro.numero).setFontWeight("bold");
    painel
      .getRange(linha, 3)
      .setValue(registro.status)
      .setBackground(corStatusPainelBo_(registro.status))
      .setFontColor(PAINEL_BO.COLORS.white)
      .setFontWeight("bold")
      .setHorizontalAlignment("center");
    painel.getRange(linha, 5).setValue(resumirPainelBo_(registro.responsavel, 34));
    painel
      .getRange(linha, 7)
      .setValue(resumirPainelBo_(registro.diligencias || "Sem diligência informada", 64));
  });
}

function atualizarInfracoesPainelBo_(painel, infracoes) {
  painel.getRange("J27:R31").clearContent().setBackground(PAINEL_BO.COLORS.white);
  painel.getRange("J27:R31").setFontColor(PAINEL_BO.COLORS.text).setFontWeight("normal");

  if (!infracoes.length) {
    painel.getRange("K27").setValue("Nenhuma infração cadastrada.").setFontColor(PAINEL_BO.COLORS.gray);
    return;
  }

  infracoes.forEach(function (item, indice) {
    const linha = 27 + indice;
    painel.getRange(linha, 10).setValue(indice + 1).setHorizontalAlignment("center");
    painel.getRange(linha, 11).setValue(resumirPainelBo_(item[0], 72));
    painel
      .getRange(linha, 18)
      .setValue(item[1])
      .setFontWeight("bold")
      .setHorizontalAlignment("center");
  });
}

function atualizarGraficosPainelBo_(planilha, painel, dados) {
  painel.getCharts().forEach(function (grafico) {
    painel.removeChart(grafico);
  });
  painel.getRange("A13:R20").clearContent().setBackground(PAINEL_BO.COLORS.white);

  const statusDados = PAINEL_BO.STATUSES.map(function (status) {
    return [status, dados.porStatus[status] || 0];
  });
  const responsaveis = compactarResponsaveisPainelBo_(dados.porResponsavel, 7);
  const maxStatus = Math.max.apply(null, statusDados.map(function (item) { return item[1]; }).concat([1]));
  const maxResponsavel = Math.max.apply(null, responsaveis.map(function (item) { return item[1]; }).concat([1]));

  statusDados.forEach(function (item, indice) {
    const linha = 13 + indice;
    painel.getRange(linha, 1).setValue(item[0]);
    painel.getRange(linha, 4).setValue(item[1]).setFontWeight("bold").setHorizontalAlignment("center");
    painel
      .getRange(linha, 5)
      .setValue(criarBarraPainelBo_(item[1], maxStatus, 16))
      .setFontColor(corStatusPainelBo_(item[0]))
      .setFontWeight("bold")
      .setFontSize(12);
  });

  if (!responsaveis.length) {
    painel.getRange("J13").setValue("Nenhum responsável informado.").setFontColor(PAINEL_BO.COLORS.gray);
  } else {
    responsaveis.forEach(function (item, indice) {
      const linha = 13 + indice;
      painel.getRange(linha, 10).setValue(resumirPainelBo_(item[0], 42));
      painel.getRange(linha, 15).setValue(item[1]).setFontWeight("bold").setHorizontalAlignment("center");
      painel
        .getRange(linha, 16)
        .setValue(criarBarraPainelBo_(item[1], maxResponsavel, 10))
        .setFontColor(PAINEL_BO.COLORS.blue)
        .setFontWeight("bold")
        .setFontSize(12);
    });
  }

  painel.getRange("A13:R20").setVerticalAlignment("middle");
  const apoio = planilha.getSheetByName(PAINEL_BO.DATA_SHEET);
  if (apoio) apoio.hideSheet();
}

function criarBarraPainelBo_(valor, maximo, tamanho) {
  if (!valor || !maximo) return "—";
  const preenchidos = Math.max(1, Math.round((valor / maximo) * tamanho));
  return "■".repeat(preenchidos) + "·".repeat(Math.max(0, tamanho - preenchidos));
}

function compactarResponsaveisPainelBo_(ordenados, limite) {
  if (ordenados.length <= limite) {
    return ordenados;
  }
  const principais = ordenados.slice(0, limite);
  const outros = ordenados.slice(limite).reduce(function (soma, item) {
    return soma + item[1];
  }, 0);
  principais.push(["Outros", outros]);
  return principais;
}

function ordenarContagensPainelBo_(objeto) {
  return Object.keys(objeto)
    .map(function (chave) {
      return [chave, objeto[chave]];
    })
    .sort(function (a, b) {
      return b[1] - a[1] || a[0].localeCompare(b[0], "pt-BR");
    });
}

function extrairInfracoesPainelBo_(texto) {
  return String(texto || "")
    .replace(/\r/g, "\n")
    .split(/\n+|(?=\d+\s*:)/)
    .map(function (item) {
      return item.trim();
    })
    .filter(Boolean);
}

function limparRotuloInfracaoPainelBo_(texto) {
  const rotulo = String(texto || "")
    .replace(/^\d+\s*:\s*/, "")
    .replace(/\s*\(ART\.?[\s\S]*$/i, "")
    .replace(/\s+/g, " ")
    .trim()
    .toUpperCase();
  return /[A-ZÀ-Ü]{2}/i.test(rotulo) ? rotulo : "";
}

function canonizarStatusPainelBo_(status) {
  const recebido = String(status || "").trim();
  if (!recebido) return "Pendente";
  const chave = normalizarPainelBo_(recebido);
  const encontrado = PAINEL_BO.STATUSES.find(function (opcao) {
    return normalizarPainelBo_(opcao) === chave;
  });
  return encontrado || recebido;
}

function pesoStatusPainelBo_(status) {
  const pesos = {
    Pendente: 1,
    Suspensa: 2,
    "Aguardando Terceiros": 3,
    "Aguardando Aprovação/Revisão": 4,
    Agendada: 5,
    "Em Andamento": 6,
  };
  return pesos[status] || 99;
}

function corStatusPainelBo_(status) {
  const cores = {
    Pendente: PAINEL_BO.COLORS.amber,
    "Em Andamento": PAINEL_BO.COLORS.blue,
    Agendada: PAINEL_BO.COLORS.cyan,
    "Aguardando Terceiros": PAINEL_BO.COLORS.purple,
    Concluída: PAINEL_BO.COLORS.green,
    Cancelada: PAINEL_BO.COLORS.red,
    Suspensa: PAINEL_BO.COLORS.gray,
    "Aguardando Aprovação/Revisão": "#9C6644",
  };
  return cores[status] || PAINEL_BO.COLORS.gray;
}

function resumirPainelBo_(texto, limite) {
  const limpo = String(texto || "").replace(/\s+/g, " ").trim();
  return limpo.length <= limite ? limpo : limpo.slice(0, limite - 1).trim() + "…";
}

function normalizarPainelBo_(texto) {
  return String(texto || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\s+/g, " ")
    .trim()
    .toUpperCase();
}
